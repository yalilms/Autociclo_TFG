{
  "info": {
    "_postman_id": "autociclo-tfg-2026",
    "name": "AutoCiclo API",
    "description": "Colección completa de la API REST de AutoCiclo. Base URL: http://109.123.247.31:8080. Autenticación JWT: usar el endpoint Login primero y copiar el token en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://109.123.247.31:8080" },
    { "key": "token",   "value": "" }
  ],
  "item": [
    {
      "name": "🔐 Autenticación",
      "item": [
        {
          "name": "Login",
          "event": [{
            "listen": "test",
            "script": { "exec": ["const r = pm.response.json();", "if(r.token) pm.collectionVariables.set('token', r.token);"] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@autociclo.es\",\n  \"password\": \"Autociclo2026!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login Empleado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"pedro@autociclo.es\",\n  \"password\": \"Autociclo2026!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login Cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"cliente@autociclo.com\",\n  \"password\": \"Autociclo2026!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Registro nuevo cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Nuevo Cliente\",\n  \"email\": \"nuevo@test.com\",\n  \"password\": \"Test1234!\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        }
      ]
    },
    {
      "name": "🔧 Piezas",
      "item": [
        {
          "name": "Listar todas las piezas",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/piezas", "host": ["{{baseUrl}}"], "path": ["api","piezas"] }
          }
        },
        {
          "name": "Buscar piezas por texto",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/piezas/buscar?q=motor", "host": ["{{baseUrl}}"], "path": ["api","piezas","buscar"], "query": [{"key":"q","value":"motor"}] }
          }
        },
        {
          "name": "Buscar piezas por categoría",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/piezas/buscar?categoria=motor", "host": ["{{baseUrl}}"], "path": ["api","piezas","buscar"], "query": [{"key":"categoria","value":"motor"}] }
          }
        },
        {
          "name": "Detalle de una pieza",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/piezas/1", "host": ["{{baseUrl}}"], "path": ["api","piezas","1"] }
          }
        },
        {
          "name": "Crear pieza (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"codigoPieza\": \"MOT-099\",\n  \"nombre\": \"Motor 1.4 TSI\",\n  \"categoria\": \"motor\",\n  \"precioVenta\": 1200.00,\n  \"stockDisponible\": 1,\n  \"stockMinimo\": 1,\n  \"ubicacionAlmacen\": \"Estantería A, nivel 3\",\n  \"compatibleMarcas\": \"Seat Ibiza 2018-2022, Volkswagen Polo\",\n  \"descripcion\": \"Motor gasolina 1.4 TSI 125CV, 70.000 km\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/piezas", "host": ["{{baseUrl}}"], "path": ["api","piezas"] }
          }
        },
        {
          "name": "Actualizar pieza (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"codigoPieza\": \"MOT-001\",\n  \"nombre\": \"Motor 1.6 TDI\",\n  \"categoria\": \"motor\",\n  \"precioVenta\": 2600.00,\n  \"stockDisponible\": 2,\n  \"stockMinimo\": 1,\n  \"ubicacionAlmacen\": \"Estantería A, nivel 2\",\n  \"compatibleMarcas\": \"Volkswagen Golf 2015-2020\",\n  \"descripcion\": \"Motor diésel actualizado\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/piezas/1", "host": ["{{baseUrl}}"], "path": ["api","piezas","1"] }
          }
        },
        {
          "name": "Eliminar pieza (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/piezas/99", "host": ["{{baseUrl}}"], "path": ["api","piezas","99"] }
          }
        }
      ]
