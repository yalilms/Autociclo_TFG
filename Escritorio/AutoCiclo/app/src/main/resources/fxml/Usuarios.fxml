<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autociclo.controllers.UsuariosController">

    <top>
        <VBox spacing="8.0">
            <padding><Insets top="15" left="15" right="15" bottom="5" /></padding>
            <Label text="👤  Gestión de Usuarios" styleClass="title-label" />
            <Label text="Solo visible para administradores" styleClass="subtitle-label" />

            <ToolBar styleClass="tool-bar" prefHeight="45.0">
                <items>
                    <Button fx:id="btnNuevoUsuario" text="Nuevo usuario"
                            styleClass="button-success" prefWidth="140.0"
                            onAction="#abrirFormularioNuevo" />
                    <Button fx:id="btnEditarUsuario" text="Editar"
                            styleClass="button-primary" prefWidth="90.0"
                            onAction="#editarUsuario" />
                    <Button fx:id="btnToggleActivo" text="Activar / Desactivar"
                            styleClass="button" prefWidth="160.0"
                            onAction="#toggleActivo" />
                    <Separator orientation="VERTICAL" prefHeight="35.0" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtBuscarUsuario"
                               promptText="Buscar por nombre o email..."
                               prefWidth="280.0" prefHeight="32.0"
                               styleClass="text-field" />
                    <Button text="Buscar" styleClass="button-primary"
                            prefWidth="80.0" prefHeight="32.0"
                            onAction="#filtrarUsuarios" />
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableUsuarios" styleClass="table-view"
                   maxHeight="Infinity" maxWidth="Infinity">
            <BorderPane.margin><Insets left="15" right="15" bottom="5" top="5" /></BorderPane.margin>
            <columns>
                <TableColumn fx:id="colUsuarioId"     text="ID"       prefWidth="55.0" />
                <TableColumn fx:id="colUsuarioNombre" text="Nombre"   prefWidth="200.0" />
                <TableColumn fx:id="colUsuarioEmail"  text="Email"    prefWidth="250.0" />
                <TableColumn fx:id="colUsuarioRol"    text="Rol"      prefWidth="110.0" />
                <TableColumn fx:id="colUsuarioActivo" text="Estado"   prefWidth="90.0" />
                <TableColumn fx:id="colUsuarioFecha"  text="Alta"     prefWidth="140.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 10 15 10 15;">
            <Label fx:id="lblStatusUsuarios" text="Cargando usuarios..."
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
        </HBox>
    </bottom>

</BorderPane>
