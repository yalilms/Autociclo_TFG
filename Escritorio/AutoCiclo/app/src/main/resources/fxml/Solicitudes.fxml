<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autociclo.controllers.SolicitudesController">

    <top>
        <VBox spacing="8.0">
            <padding><Insets top="15" left="15" right="15" bottom="5" /></padding>
            <Label text="📋  Solicitudes y Negociaciones" styleClass="title-label" />
            <Label text="Aprobar · Rechazar · Contraofertar · Integración con Odoo" styleClass="subtitle-label" />

            <ToolBar styleClass="tool-bar" prefHeight="45.0">
                <items>
                    <Button fx:id="btnAprobar" text="✅  Aprobar"
                            styleClass="button-success" prefWidth="120.0"
                            onAction="#aprobarSolicitud" />
                    <Button fx:id="btnRechazar" text="❌  Rechazar"
                            styleClass="button-danger" prefWidth="120.0"
                            onAction="#rechazarSolicitud" />
                    <Button fx:id="btnContraoferta" text="  Contraofertar"
                            styleClass="button-primary" prefWidth="145.0"
                            onAction="#contraofertarSolicitud">
                        <graphic><FontIcon iconLiteral="mdi2r-reply" iconSize="16" iconColor="white" /></graphic>
                    </Button>
                    <Button fx:id="btnRefrescar" text="  Refrescar"
                            styleClass="button" prefWidth="110.0"
                            onAction="#cargarSolicitudes">
                        <graphic><FontIcon iconLiteral="mdi2r-refresh" iconSize="16" iconColor="#94a3b8" /></graphic>
                    </Button>
                    <Separator orientation="VERTICAL" prefHeight="35.0" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtFiltroEstado"
                               promptText="Filtrar por estado o cliente…"
                               prefWidth="260.0" prefHeight="32.0"
                               styleClass="text-field" />
                    <Button text="Filtrar" styleClass="button-primary"
                            prefWidth="80.0" prefHeight="32.0"
                            onAction="#filtrarSolicitudes" />
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tableSolicitudes" styleClass="table-view"
                   maxHeight="Infinity" maxWidth="Infinity">
            <BorderPane.margin><Insets left="15" right="15" bottom="5" top="5" /></BorderPane.margin>
            <columns>
                <TableColumn fx:id="colSolId"       text="ID"              prefWidth="45.0" />
                <TableColumn fx:id="colSolCliente"  text="Cliente"         prefWidth="150.0" />
                <TableColumn fx:id="colSolEstado"   text="Estado"          prefWidth="130.0" />
                <TableColumn fx:id="colSolFecha"    text="Fecha"           prefWidth="130.0" />
                <TableColumn fx:id="colSolOferta"   text="Oferta cliente"  prefWidth="105.0" />
                <TableColumn fx:id="colSolContrao"  text="Contraoferta"    prefWidth="105.0" />
                <TableColumn fx:id="colSolOdoo"     text="Ref. Odoo"       prefWidth="110.0" />
                <TableColumn fx:id="colSolRespuesta" text="Mensaje admin"  prefWidth="200.0" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 8 15 8 15;">
            <Label fx:id="lblStatusSolicitudes" text="Cargando solicitudes..."
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblOdooRef" text=""
                   style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
