<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.autociclo.controllers.SolicitudesController">

    <top>
        <VBox spacing="8.0">
            <padding><Insets top="15" left="15" right="15" bottom="5" /></padding>
            <Label text="📋  Solicitudes de Presupuesto" styleClass="title-label" />
            <Label text="Aprobar o rechazar solicitudes · Integración con Odoo" styleClass="subtitle-label" />

            <ToolBar styleClass="tool-bar" prefHeight="45.0">
                <items>
                    <Button fx:id="btnAprobar" text="✅  Aprobar"
                            styleClass="button-success" prefWidth="130.0"
                            onAction="#aprobarSolicitud" />
                    <Button fx:id="btnRechazar" text="❌  Rechazar"
                            styleClass="button-danger" prefWidth="130.0"
                            onAction="#rechazarSolicitud" />
                    <Button fx:id="btnRefrescar" text="🔄  Refrescar"
                            styleClass="button" prefWidth="120.0"
                            onAction="#cargarSolicitudes" />
                    <Separator orientation="VERTICAL" prefHeight="35.0" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="txtFiltroEstado"
                               promptText="Filtrar por estado (pendiente, aprobada…)"
                               prefWidth="280.0" prefHeight="32.0"
                               styleClass="text-field" />
                    <Button text="Filtrar" styleClass="button-primary"
                            prefWidth="80.0" prefHeight="32.0"
                            onAction="#filtrarSolicitudes" />
                </items>
            </ToolBar>
        </VBox>
    </top>

    <center>
        <VBox spacing="0">
            <BorderPane.margin><Insets left="15" right="15" bottom="5" top="5" /></BorderPane.margin>
            <TableView fx:id="tableSolicitudes" prefHeight="400.0" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colSolId"       text="ID"       prefWidth="55.0" />
                    <TableColumn fx:id="colSolCliente"  text="Cliente"  prefWidth="200.0" />
                    <TableColumn fx:id="colSolEstado"   text="Estado"   prefWidth="120.0" />
                    <TableColumn fx:id="colSolFecha"    text="Fecha"    prefWidth="160.0" />
                    <TableColumn fx:id="colSolPrecio"   text="Precio €" prefWidth="100.0" />
                    <TableColumn fx:id="colSolRespuesta" text="Respuesta admin" prefWidth="250.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 8 15 8 15;">
            <Label fx:id="lblStatusSolicitudes" text="Cargando solicitudes..."
                   style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblOdooRef" text=""
                   style="-fx-text-fill: #10b981; -fx-font-size: 12px; -fx-font-weight: bold;" />
        </HBox>
    </bottom>

</BorderPane>
