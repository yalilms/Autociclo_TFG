<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane prefHeight="750.0" prefWidth="1150.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autociclo.controllers.LoginController"
           stylesheets="@../css/styles.css"
           styleClass="root">

    <!-- Fondo con blur -->
    <ImageView fitHeight="750.0" fitWidth="1150.0" preserveRatio="false">
        <image>
            <Image url="@../images/listados_background.png" />
        </image>
        <effect>
            <BoxBlur width="20" height="20" iterations="3" />
        </effect>
    </ImageView>

    <!-- Tarjeta central de login -->
    <VBox alignment="CENTER" spacing="20.0" maxWidth="420.0" styleClass="glass-pane">
        <padding>
            <Insets top="45" right="45" bottom="45" left="45" />
        </padding>

        <!-- Logo + Título -->
        <ImageView fitHeight="72.0" fitWidth="72.0" preserveRatio="true">
            <image>
                <Image url="@../imagenes/logo_autociclo.png" />
            </image>
        </ImageView>

        <Label text="AutoCiclo" styleClass="title-label" />
        <Label text="Gestión de Desguace · Acceso al Sistema" styleClass="subtitle-label" />

        <!-- Email -->
        <VBox spacing="6.0">
            <Label text="Correo electrónico" styleClass="label" />
            <TextField fx:id="txtEmail"
                       promptText="admin@autociclo.com"
                       prefHeight="38.0" prefWidth="330.0"
                       styleClass="text-field" />
        </VBox>

        <!-- Contraseña -->
        <VBox spacing="6.0">
            <Label text="Contraseña" styleClass="label" />
            <PasswordField fx:id="txtPassword"
                           promptText="••••••••"
                           prefHeight="38.0" prefWidth="330.0"
                           styleClass="text-field" />
        </VBox>

        <!-- Error -->
        <Label fx:id="lblError"
               text=""
               visible="false"
               style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"
               wrapText="true"
               maxWidth="330.0" />

        <!-- Botón acceder -->
        <Button fx:id="btnAcceder"
                text="Acceder"
                prefWidth="330.0" prefHeight="42.0"
                styleClass="button-success"
                onAction="#handleLogin"
                defaultButton="true" />

        <!-- Versión -->
        <Label text="v3.0 · Entrega 3 · IES P. Hermenegildo Lanz"
               style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
    </VBox>

</StackPane>
