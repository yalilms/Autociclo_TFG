<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.BoxBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="750.0" prefWidth="1150.0"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.autociclo.controllers.LoginController"
           stylesheets="@../css/styles.css"
           styleClass="root">

    <!-- Fondo con blur -->
    <ImageView fitHeight="750.0" fitWidth="1150.0" preserveRatio="false">
        <image>
            <Image url="@../images/listados_background.png" />
        </image>
        <effect>
            <BoxBlur width="20" height="20" iterations="3" />
        </effect>
    </ImageView>

    <!-- Tarjeta central de login -->
    <VBox alignment="CENTER" spacing="20.0" maxWidth="420.0" styleClass="glass-pane">
        <padding>
            <Insets top="45" right="45" bottom="45" left="45" />
        </padding>

        <!-- Logo + Título -->
        <ImageView fx:id="logoImg" fitHeight="72.0" fitWidth="72.0" preserveRatio="false">
            <image>
                <Image url="@../imagenes/logo_autociclo.png" />
            </image>
        </ImageView>

        <Label text="AutoCiclo" styleClass="title-label" />
        <Label text="Gestión de Desguace · Acceso al Sistema" styleClass="subtitle-label" />

        <!-- Email -->
        <VBox spacing="6.0">
            <Label text="Usuario" styleClass="label" />
            <HBox alignment="CENTER_LEFT" prefHeight="38.0" prefWidth="330.0"
                  style="-fx-background-color: rgba(30,41,59,0.8); -fx-border-color: rgba(255,255,255,0.1); -fx-border-radius: 8; -fx-background-radius: 8;">
                <TextField fx:id="txtEmail"
                           promptText="admin"
                           prefHeight="38.0"
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 0 0 0 12; -fx-border-color: transparent;" />
                <Label fx:id="lblDominio" text=""
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-padding: 0 12 0 0;" />
            </HBox>
        </VBox>

        <!-- Contraseña -->
        <VBox spacing="6.0">
            <Label text="Contraseña" styleClass="label" />
            <HBox spacing="6.0" alignment="CENTER_LEFT">
                <PasswordField fx:id="txtPassword"
                               promptText="••••••••"
                               prefHeight="38.0" prefWidth="292.0"
                               styleClass="text-field" />
                <TextField fx:id="txtPasswordVisible"
                           promptText="••••••••"
                           prefHeight="38.0" prefWidth="292.0"
                           styleClass="text-field"
                           visible="false" managed="false" />
                <Button fx:id="btnVerPass"
                        prefHeight="38.0" prefWidth="38.0"
                        onAction="#togglePassword"
                        style="-fx-background-color: #1e293b; -fx-cursor: hand; -fx-background-radius: 8;">
                    <graphic>
                        <FontIcon fx:id="iconoOjo" iconLiteral="mdi2e-eye-off" iconSize="18" iconColor="#94a3b8" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- Error -->
        <Label fx:id="lblError"
               text=""
               visible="false"
               style="-fx-text-fill: #ef4444; -fx-font-size: 13px;"
               wrapText="true"
               maxWidth="330.0" />

        <!-- Botón acceder -->
        <Button fx:id="btnAcceder"
                text="Acceder"
                prefWidth="330.0" prefHeight="42.0"
                styleClass="button-success"
                onAction="#handleLogin"
                defaultButton="true" />
    </VBox>

</StackPane>
